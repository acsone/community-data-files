<odoo>

    <record id="product_packaging_form_view" model="ir.ui.view">
        <field name="model">product.packaging</field>
        <field name="inherit_id" ref="product.product_packaging_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='qty']" position="inside">
                <field name="unece_code" />
            </xpath>
        </field>
    </record>

    <record id="product_packaging_search_view" model="ir.ui.view">
        <field name="model">product.packaging</field>
        <field name="inherit_id" ref="product.product_packaging_tree_view" />
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="unece_code" optional="hide" />
            </xpath>
        </field>
    </record>

</odoo>
